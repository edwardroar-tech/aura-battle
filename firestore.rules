rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function clanDoc(clanId) { return get(/databases/$(database)/documents/clans/$(clanId)); }
    function isClanLeader(clanId) { return signedIn() && clanDoc(clanId).data.owner == request.auth.uid; }
    function isClanCoLeader(clanId) {
      let c = clanDoc(clanId).data;
      return signedIn() && c.keys().hasAll(['coLeader']) && c.coLeader == request.auth.uid;
    }
    function isClanManager(clanId) { return isClanLeader(clanId) || isClanCoLeader(clanId); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /battleInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid && request.resource.data.roomCode is string && request.resource.data.roomCode.size() == 6 && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.senderId == resource.data.senderId && request.resource.data.receiverId == resource.data.receiverId && request.resource.data.roomCode == resource.data.roomCode && request.resource.data.status in ['accepted','declined'];
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /privateChats/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2 && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /clanTags/{tag} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.tag == tag;
      allow update: if signedIn() && request.resource.data.tag == tag;
      allow delete: if false;
    }

    match /clanJoinRequests/{requestId} {
      // Join request: requester can read/manage their own request; clan managers can review it.
      // Clan invite: sender/manager and receiver can read it; receiver can accept/reject it.
      allow read: if signedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isClanManager(resource.data.clanId)
      );

      allow create: if signedIn() && request.resource.data.status == 'pending' && (
        (
          request.resource.data.kind == 'invite' &&
          request.resource.data.requesterId == request.auth.uid &&
          request.resource.data.receiverId is string &&
          request.resource.data.receiverId != request.auth.uid &&
          isClanManager(request.resource.data.clanId)
        ) ||
        (
          request.resource.data.kind == 'join' || !request.resource.data.keys().hasAll(['kind'])
        ) &&
        request.resource.data.requesterId == request.auth.uid &&
        !(request.auth.uid in clanDoc(request.resource.data.clanId).data.members)
      );

      allow update: if signedIn() && (
        (
          isClanManager(resource.data.clanId) &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.clanId == resource.data.clanId &&
          request.resource.data.receiverId == resource.data.receiverId &&
          request.resource.data.kind == resource.data.kind &&
          request.resource.data.status in ['accepted','rejected']
        ) ||
        (
          resource.data.requesterId == request.auth.uid &&
          resource.data.kind != 'invite' &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending'
        ) ||
        (
          resource.data.receiverId == request.auth.uid &&
          resource.data.kind == 'invite' &&
          resource.data.status == 'pending' &&
          request.resource.data.status in ['accepted','rejected'] &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.receiverId == resource.data.receiverId &&
          request.resource.data.clanId == resource.data.clanId &&
          request.resource.data.kind == resource.data.kind
        )
      );

      allow delete: if signedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isClanManager(resource.data.clanId)
      );
    }

    match /clanInvites/{inviteId} {
      allow read: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isClanManager(resource.data.clanId)
      );

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.clanId is string
        && request.resource.data.status == 'pending'
        && isClanManager(request.resource.data.clanId);

      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && resource.data.senderId == request.resource.data.senderId
        && resource.data.receiverId == request.resource.data.receiverId
        && resource.data.clanId == request.resource.data.clanId
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','declined'];

      allow delete: if signedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isClanManager(resource.data.clanId)
      );
    }

    match /clans/{clanId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.tag is string
        && request.resource.data.tag.size() >= 2
        && request.resource.data.tag.size() <= 6
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members;

      // Leader: membership/co-leader administration and leadership transfer.
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','coLeader']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner','coLeader'])
        )
        && request.resource.data.owner in request.resource.data.members;

      // Co-leader: can add/remove members but cannot change the leader or co-leader role.
      allow update: if signedIn()
        && resource.data.keys().hasAll(['coLeader'])
        && resource.data.coLeader == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.coLeader == resource.data.coLeader
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.auth.uid in request.resource.data.members;

      // A regular member can leave by removing only themselves.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.owner
        && (!resource.data.keys().hasAll(['coLeader']) || resource.data.coLeader != request.auth.uid)
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // A co-leader can leave and simultaneously clear their role.
      allow update: if signedIn()
        && resource.data.keys().hasAll(['coLeader'])
        && resource.data.coLeader == request.auth.uid
        && request.resource.data.members is list
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','coLeader']);

      // An invited player can accept by adding only themselves to the clan.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && get(/databases/$(database)/documents/clanJoinRequests/$(clanId)_invite_$(request.auth.uid)).data.kind == 'invite'
        && get(/databases/$(database)/documents/clanJoinRequests/$(clanId)_invite_$(request.auth.uid)).data.receiverId == request.auth.uid
        && get(/databases/$(database)/documents/clanJoinRequests/$(clanId)_invite_$(request.auth.uid)).data.status == 'pending';

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      // A player can create the deterministic friendship document when they are one of its two participants.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      // Also allow repairing/updating an existing friendship document if the new data contains the current user.
      // This fixes acceptance when a stale document already exists from an earlier test.
      allow update: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /battleInvites/{inviteId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() == 6
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && resource.data.receiverId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.status in ['accepted','declined'];

      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /privateChats/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /clanTags/{tag} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.tag == tag;
      allow update: if signedIn() && request.resource.data.tag == tag;
      allow delete: if false;
    }

    match /clanJoinRequests/{requestId} {
      allow read: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || get(/databases/$(database)/documents/clans/$(resource.data.clanId)).data.owner == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.clanId is string
        && request.resource.data.clanName is string
        && request.resource.data.requesterName is string
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && (
          (
            get(/databases/$(database)/documents/clans/$(resource.data.clanId)).data.owner == request.auth.uid
            && request.resource.data.clanId == resource.data.clanId
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.status in ['accepted','rejected']
          )
          || (
            resource.data.requesterId == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.clanId == resource.data.clanId
            && request.resource.data.requesterId == request.auth.uid
            && request.resource.data.status == 'pending'
          )
        );

      allow delete: if signedIn()
        && (
          resource.data.requesterId == request.auth.uid
          || get(/databases/$(database)/documents/clans/$(resource.data.clanId)).data.owner == request.auth.uid
        );
    }

    match /clans/{clanId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.tag is string
        && request.resource.data.tag.size() >= 2
        && request.resource.data.tag.size() <= 6;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members.size() <= 1000;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}

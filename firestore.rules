rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /battleInvites/{inviteId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid && request.resource.data.receiverId is string && request.resource.data.receiverId != request.auth.uid && request.resource.data.roomCode is string && request.resource.data.roomCode.size() == 6 && request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.senderId == resource.data.senderId && request.resource.data.receiverId == resource.data.receiverId && request.resource.data.roomCode == resource.data.roomCode && request.resource.data.status in ['accepted','declined'];
      allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
    }

    match /chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /privateChats/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.auth.uid in request.resource.data.participants && request.resource.data.participants.size() == 2 && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    match /clanTags/{tag} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.tag == tag;
      allow update: if signedIn() && request.resource.data.tag == tag;
      allow delete: if false;
    }

    match /clanJoinRequests/{requestId} {
      // Kept open to authenticated clients for the current clan prototype.
      // The app enforces join/invite semantics; production hardening can follow after testing.
      allow read, create, update, delete: if signedIn();
    }

    match /clans/{clanId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.tag is string
        && request.resource.data.tag.size() >= 2
        && request.resource.data.tag.size() <= 6
        && request.resource.data.members is list
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members;

      // Leader: full clan administration, including leadership transfer and co-leader changes.
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000;

      // Co-leader: can manage membership only, but cannot change owner/coLeader.
      allow update: if signedIn()
        && resource.data.get('coLeader', '') == request.auth.uid
        && request.resource.data.owner == request.resource.data.owner
        && request.resource.data.get('coLeader', '') == resource.data.get('coLeader', '')
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      // Regular member: may only remove themselves from members.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.owner
        && request.auth.uid != resource.data.get('coLeader', '')
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 1000
        && !(request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
